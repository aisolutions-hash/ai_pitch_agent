# ---- Kalisoft AI Sales Pipeline (FastAPI) ----
# Copy to .env for local development. Never commit the real .env.

ENV=development
SECRET_KEY=generate-a-32-byte-hex-secret
AUTH_DEV_MODE=true
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Sign-In (OAuth Web client ID) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_ALLOWED_DOMAINS=kalisoftai.com

# --- Google Cloud / GCS ---
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET_CONTACTS=kalisoftai-datahub
GCS_PATH_CONTACTS=all-sales-contacts-data
# Application Default Credentials are used automatically on Cloud Run.

# --- Database ---
# Local Postgres:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sales_pipeline
# Cloud SQL (unix socket):
# CLOUD_SQL_CONNECTION_NAME=project:asia-south1:instance
# POSTGRES_DB=sales_pipeline
# POSTGRES_USER=sales
# POSTGRES_PASSWORD=change-me
# If nothing is set, the app falls back to local SQLite (sales_pipeline.db).

# --- Redis (cron queue / voice cache) ---
REDIS_URL=redis://localhost:6379/0

# --- SMTP / IMAP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=

# --- AI (Gemma / Gemini) ---
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# --- WhatsApp Cloud API ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- LinkedIn / Reddit ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
