DJANGO_SECRET_KEY=generate-a-long-random-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=.run.app,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://sales-agent-PROJECT_ID.us-central1.run.app
APP_USERNAME=admin
APP_PASSWORD=your-strong-password

# Neon PostgreSQL
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# APIs
GEMINI_API_KEY=your-gemini-key
SERPAPI_API_KEY=your-serpapi-key

# GCS
GCS_BUCKET_NAME=your-bucket-name

# Scheduled scraper — Cloud Scheduler calls /scraper/scheduler/run/ with this secret
SCHEDULER_SECRET=generate-a-long-random-secret

# Google Sheets
GOOGLE_SHEET_ID=your-sheet-id
LINKEDIN_SHEET_ID=your-linkedin-sheet-id
PITCH_SHEET_ID=your-pitch-sheet-id
# NOTE: do NOT set GOOGLE_CREDENTIALS_PATH on Cloud Run unless you mount the
# key file via Secret Manager (credentials.json is excluded from the image).
# Leave it unset so Cloud Run uses its runtime service account — you must then:
#   1. Enable "Google Sheets API" and "Google Drive API" in the GCP project
#   2. Share the spreadsheet with the Cloud Run service account's email
# The same applies to GCS (bucket access for the runtime service account).

# Email (Gmail SMTP) — use app passwords, not your regular Gmail password
SERVER_EMAIL=sales@yourdomain.com
PITCH_EMAIL_HOST_USER=sales@yourdomain.com
PITCH_GMAIL_APP_PASSWORD=your-gmail-app-password
DEFAULT_FROM_NAME=KalisoftAI
SITE_URL=https://sales-agent-PROJECT_ID.us-central1.run.app
