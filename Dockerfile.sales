FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-sales.txt .
RUN pip install --no-cache-dir -r requirements-sales.txt

COPY sales_fastapi ./sales_fastapi
COPY run.py pytest.ini ./

# Cloud Run provides PORT (default 8080)
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn sales_fastapi.main:app --host 0.0.0.0 --port ${PORT}"]
