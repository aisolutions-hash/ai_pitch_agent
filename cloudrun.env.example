DJANGO_SECRET_KEY=generate-a-long-random-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=.run.app,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://sales-agent-PROJECT_ID.us-central1.run.app

# Neon PostgreSQL
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# APIs
GEMINI_API_KEY=your-gemini-key
SERPAPI_API_KEY=your-serpapi-key

# GCS
GCS_BUCKET_NAME=your-bucket-name

# Google Sheets
GOOGLE_SHEET_ID=your-sheet-id

# Email (Gmail SMTP) — use app passwords, not your regular Gmail password
SERVER_EMAIL=sales@yourdomain.com
PITCH_EMAIL_HOST_USER=sales@yourdomain.com
PITCH_GMAIL_APP_PASSWORD=your-gmail-app-password
DEFAULT_FROM_NAME=KalisoftAI
SITE_URL=https://sales-agent-PROJECT_ID.us-central1.run.app
